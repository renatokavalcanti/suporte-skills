# ---------------------------------------------------------------------------
# Suporte Skills - variaveis do ambiente de NUVEM (Azure) - D-037.
#
# Copie para .env na VM e preencha. NUNCA versione o .env real.
# Complementa (nao substitui) o .env.example: aqui ficam so' os valores que
# mudam na nuvem.
# ---------------------------------------------------------------------------

# --- Acesso / TLS (lidos pelo Caddy no docker-compose.cloud.yml) ---
DOMAIN=skills.suporteinformatica.com
ACME_EMAIL=ti@suporteinformatica.com

# --- URLs publicas (precisam bater com o dominio HTTPS) ---
PUBLIC_API_URL=https://skills.suporteinformatica.com
PUBLIC_WEB_URL=https://skills.suporteinformatica.com

# --- Banco de dados ---
POSTGRES_USER=suporte
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=suporte_skills

# --- Segredos (gere com: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=coloque-um-segredo-de-48-caracteres
JWT_REFRESH_SECRET=coloque-outro-segredo-de-48-caracteres
# Chave da cifra em repouso (IA/Zoho/e-mail). Se vazio, cai no JWT_ACCESS_SECRET.
SETTINGS_ENCRYPTION_KEY=coloque-uma-chave-de-48-caracteres

# --- Modulos ---
TICKETS_ENABLED=true
VITE_TICKETS_ENABLED=true
BUSINESS_TIMEZONE=America/Recife

# --- Integracao Zoho (opt-in; a tela de Configuracoes tem prioridade) ---
ZOHO_SYNC_ENABLED=false
