# ---------------------------------------------------------------------------
# Suporte Skills - variaveis do docker-compose
# Copie para .env (na raiz) antes de `docker compose up`.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=suporte
POSTGRES_PASSWORD=suporte
POSTGRES_DB=suporte_skills
POSTGRES_PORT=5432

# Portas publicadas no host
API_PORT=4000
WEB_PORT=8080
WEB_TLS_PORT=443

# Certificado TLS do nginx (HTTPS). Gere com: bash scripts/gen-certs.sh
# O nginx le /etc/nginx/certs/fullchain.pem e privkey.pem (volume ./certs).

# Autenticacao
# Em producao (NODE_ENV=production) cada segredo precisa ter >= 32 caracteres
# e ser diferente do outro - a API se recusa a subir fora dessa regra.
# Estes valores sao apenas placeholders de desenvolvimento: TROQUE em producao
# (ex.: openssl rand -hex 32).
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-no-minimo-32-caracteres
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-com-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Protecao contra forca bruta no login (tentativas falhas por IP + e-mail)
# Padrao: 5 em producao, 10 em desenvolvimento. Minimo 32 caracteres para os
# segredos acima quando NODE_ENV=production.
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MINUTES=15

# CORS (origem da SPA servida pelo nginx - agora via HTTPS)
CORS_ORIGIN=https://localhost,https://127.0.0.1

# Regras de negocio
CERT_EXPIRING_DAYS=90
BUSINESS_TIMEZONE=America/Sao_Paulo

# Tec News - ingestao dos feeds oficiais (RSS/Atom)
# Desligado por padrao: o container precisa de saida HTTPS para os fabricantes.
# A curadoria manual e a busca "Sincronizar agora" funcionam independentemente.
NEWS_SYNC_ENABLED=false
NEWS_SYNC_INTERVAL_MINUTES=360
NEWS_FETCH_TIMEOUT_MS=10000
NEWS_MAX_ITEMS_PER_SOURCE=30

# Tec News - resumo inteligente (destaques para o consultor)
# Gera, na sincronizacao, um resumo das novidades mais relevantes (foco em
# funcionalidades de produto e certificacoes tecnicas). Exige a IA configurada.
NEWS_DIGEST_ENABLED=false
NEWS_DIGEST_WINDOW_DAYS=7
NEWS_DIGEST_MAX_ITEMS=20

# IA (endpoint compativel com OpenAI: OpenAI, DeepSeek, Groq, OpenRouter, Ollama...)
# Opt-in: ligue com AI_ENABLED=true e informe AI_API_KEY. O container precisa de
# saida HTTPS para o provedor escolhido.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# Segredo para cifrar valores sensiveis salvos pela tela de Configuracoes
# (ex.: chave da API de IA). Opcional: se vazio, usa o JWT_ACCESS_SECRET.
# Em producao, prefira um valor proprio (ex.: openssl rand -hex 32). Trocar o
# segredo invalida uma chave ja salva pela interface (basta salva-la de novo).
SETTINGS_ENCRYPTION_KEY=

# Tickets (D-029) - espelho dos chamados do Zoho Desk + Medicoes Mensais.
# O modulo fica DESLIGADO por padrao ate a fase de release.
TICKETS_ENABLED=false
# Sincronizacao com o Zoho Desk (opt-in; somente leitura no Zoho). Desligada por
# padrao para nao gerar trafego de saida nem depender do Zoho. As credenciais
# podem vir daqui (fallback) OU da tela Configuracoes > Integracao Zoho (cifradas
# em repouso); em ambos os casos nunca sao devolvidas pela API nem ficam em log.
ZOHO_SYNC_ENABLED=false
ZOHO_SYNC_INTERVAL_MINUTES=360
ZOHO_FETCH_TIMEOUT_MS=15000
ZOHO_MAX_TICKETS_PER_RUN=200
# Opcional: sobrepoe os dominios derivados do data center escolhido na interface
# (com|eu|in|au|cn|jp). Deixe VAZIO para usar o data center da tela; preencha so'
# para testes (ex.: mock local http://127.0.0.1:4999).
ZOHO_API_BASE_URL=
ZOHO_ACCOUNTS_BASE_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# URL publica da API (base da Redirect URI do OAuth do Zoho exibida na tela).
PUBLIC_API_URL=http://localhost:4000
# URL publica da interface web (destino do callback OAuth "Conectar com Zoho").
PUBLIC_WEB_URL=http://localhost:5173

# Build da SPA (docker compose): liga o menu/rotas de Clientes/Tickets/Medicoes.
# Manter alinhado com TICKETS_ENABLED. So' no release (padrao false).
VITE_TICKETS_ENABLED=false

# Anexos (D-025): pasta persistente dos comprovantes (bind mount ./data/uploads)
# e limite de tamanho por arquivo (MB, entre 1 e 50).
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=10

# Seed DEMO
SEED_ADMIN_EMAIL=admin@suporte.local
SEED_ADMIN_PASSWORD=Admin@123
