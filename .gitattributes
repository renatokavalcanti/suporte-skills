# Normaliza finais de linha no repositorio (armazenado como LF).
* text=auto

# Scripts e arquivos que rodam em ambiente Linux precisam de LF.
*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binarios
*.png binary
*.jpg binary
*.ico binary
